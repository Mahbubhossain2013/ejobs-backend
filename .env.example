# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=JobPortal
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.ejobs.bd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# DATABASE
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=job_portal
DB_USERNAME=root
DB_PASSWORD=

# ===========================================
# SESSION & CACHE
# ===========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ejobs.bd
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://ejobs.bd,https://admin.ejobs.bd

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ===========================================
# REDIS (Auto-detected, falls back to database)
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# MAIL
# ===========================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@ejobs.bd
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# FRONTEND & CORS
# ===========================================
FRONTEND_URL=https://ejobs.bd
SANCTUM_STATEFUL_DOMAINS=ejobs.bd,admin.ejobs.bd

# ===========================================
# BROADCASTING (Laravel Reverb)
# ===========================================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ===========================================
# VITE
# ===========================================
VITE_APP_NAME="${APP_NAME}"

# ===========================================
# PAYMENT WEBHOOK SECURITY
# ===========================================
ONIPAY_WEBHOOK_SECRET=

# ===========================================
# bKash MERCHANT GATEWAY
# ===========================================
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized
# Production: https://tokenized.pay.bka.sh/v1.2.0-beta/tokenized
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=${APP_URL}/api/payment/bkash/callback

# ===========================================
# SSLCommerz GATEWAY
# ===========================================
# Sandbox: https://sandbox.sslcommerz.com
# Production: https://securepay.sslcommerz.com
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
SSLCZ_CALLBACK_URL=${APP_URL}/api/payment/sslcommerz/callback

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_DISK=local
BACKUP_AUTO_CLEAN=true

# ===========================================
# CRON WEBHOOK TOKEN
# ===========================================
CRON_SECRET_TOKEN=

# ===========================================
# SOCIAL AUTHENTICATION
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/api/auth/facebook/callback
